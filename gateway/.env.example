# Copy to .env on the VPS (chmod 600). Never commit .env.

# xiaozhi.me agent MCP endpoint, from the StackChan app: Settings -> MCP.
# Contains a secret token: set it with scripts/set-endpoint.sh instead of editing by hand.
MCP_ENDPOINT=

# Panel login (single user). The hash comes from scripts/hash-password.ts; the password itself is never stored.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# 32 random bytes (openssl rand -base64 32): encrypts the API keys of external MCP servers.
# Changing it makes the stored secrets unreadable (re-add the MCP servers).
SECRETS_KEY=

PUBLIC_URL=https://m5.pulpfy.com

# Master switch: false = container stays up but does not connect (instant rollback).
GATEWAY_ENABLED=true

# Default modules (the panel can switch them on/off later): diagnostics,stories,music,weather
MODULES=stories,music,weather

# Expose tools marked risk=restricted. Keep false: children talk to this robot.
ALLOW_RESTRICTED_TOOLS=false

GATEWAY_TIMEZONE=America/Sao_Paulo
TOOL_TIMEOUT_MS=8000
MAX_UPLOAD_MB=60
LOG_LEVEL=info
